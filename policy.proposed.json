{
  "policy_version": "2.0",
  "description": "Illustrative proposed policy for testing AuthTrace policy-change impact. This intentionally changes cross-user invoice access to allow and should be treated as a high-risk example, not a recommended production policy.",
  "rules": [
    {
      "id": "INV-READ-OWN",
      "actor": "user",
      "action": "read_invoice",
      "resource": "invoice",
      "condition": "invoice.owner_id == actor.user_id",
      "expected": "allow"
    },
    {
      "id": "INV-READ-OTHER",
      "actor": "user",
      "action": "read_invoice",
      "resource": "invoice",
      "condition": "invoice.owner_id != actor.user_id",
      "expected": "deny"
    },
    {
      "id": "INV-READ-ADMIN",
      "actor": "admin",
      "action": "read_invoice",
      "resource": "invoice",
      "condition": "actor.role == admin",
      "expected": "allow"
    }
  ],
  "scope": {
    "base_url": "http://127.0.0.1:8000",
    "allowed_hosts": [
      "127.0.0.1",
      "localhost"
    ],
    "default_methods": [
      "GET"
    ]
  }
}
